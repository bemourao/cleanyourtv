<?xml version="1.0" encoding="utf-8"?>
<!-- Lexend at weight 400 and 700 for the on-TV font choice; a variable font, so the weight is pinned here. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/f_lexend"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        tools:targetApi="28" />
    <font
        android:font="@font/f_lexend"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        tools:targetApi="28" />
</font-family>